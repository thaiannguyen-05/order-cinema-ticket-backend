  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Mean online context precision/recall (LLM-judge proxy). Only vector/both support path is evaluated. Instant avg since boot (dev-friendly: works with 1 sample).",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(app_ai_rag_context_precision_sum) / clamp_min(sum(app_ai_rag_context_precision_count), 1)",
          "legendFormat": "precision avg",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(app_ai_rag_context_recall_sum) / clamp_min(sum(app_ai_rag_context_recall_count), 1)",
          "legendFormat": "recall avg",
          "refId": "B"
        }
      ],
      "title": "RAG precision/recall avg",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "p50/p95 precision from histogram buckets (instant quantile, works with sparse dev traffic).",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (app_ai_rag_context_precision_bucket))",
          "legendFormat": "precision p95",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (app_ai_rag_context_precision_bucket))",
          "legendFormat": "precision p50",
          "refId": "B"
        }
      ],
      "title": "Precision p50/p95",
      "type": "timeseries"
    },
