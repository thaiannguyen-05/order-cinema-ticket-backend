model Film {
    id      String @id @default(uuid()) @db.Uuid
    film_id Int    @unique
    imdb_id Int

    film_name     String
    other_titles  String?
    release_dates Json?
    age_rating    Json?
    film_trailer  String?
    synopsis_long String?
    images        Json?

    pathOfCinema FilmOfCinema[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model FilmOfCinema {
    id String @id @default(uuid()) @db.Uuid

    cinemaId String @db.Uuid
    filmId   String @db.Uuid

    film   Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)
    cinema Cinema @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

    seats     Seat[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([filmId, cinemaId])
    @@index([cinemaId])
    @@index([filmId])
}

model Cinema {
    id        String @id @default(uuid()) @db.Uuid
    cinema_id Int    @unique

    cinema_name String
    address     String?
    address2    String?
    city        String?
    state       String?
    country     String?
    county      String?
    postcode    String?
    phone       String?
    lat         String?
    lng         String?
    distance    String?
    directions  String?
    logo_url    String?
    show_dates  Json?

    films     FilmOfCinema[]
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt
}
