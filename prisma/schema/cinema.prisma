model Seat {
    id String @id @default(uuid()) @db.Uuid

    row    String
    column String

    seatType   SeatType
    seatStatus SeatStatus

    filmId String @db.Uuid

    ticket       Ticket?
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    filmOfCinema FilmOfCinema? @relation(fields: [filmId], references: [id], onDelete: Cascade)

    @@index([filmId])
}

model Ticket {
    id    String @id @default(uuid()) @db.Uuid
    combo Json?
    price Int

    seatId String @unique @db.Uuid
    seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
    order  Order?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum SeatType {
    COUPLE
    HEAVEN
    NORMAL
}

enum SeatStatus {
    AVAILABLE
    BOOKED
    NOT_AVAILABLE
}